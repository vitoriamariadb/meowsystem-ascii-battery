{
  "id": "io.github.meowsystem.AsciiBattery",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "command": "meowsystem-ascii-battery",
  "finish-args": [
    "--socket=wayland",
    "--share=ipc",
    "--device=dri",
    "--filesystem=xdg-config/cosmic:rw",
    "--filesystem=/sys/class/power_supply:ro",
    "--filesystem=/sys/class/backlight:ro",
    "--filesystem=/sys/class/leds:ro",
    "--talk-name=com.system76.CosmicSettingsDaemon",
    "--system-talk-name=net.hadess.PowerProfiles",
    "--system-talk-name=org.freedesktop.login1"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_BUILD_JOBS": "8",
      "CARGO_HOME": "/run/build/meowsystem-ascii-battery/cargo",
      "LOCKSTEP_XML_PATH": "/run/build/meowsystem-ascii-battery/cargo/vendor/atspi-common-0.13.0/xml"
    }
  },
  "modules": [
    {
      "name": "meowsystem-ascii-battery",
      "buildsystem": "simple",
      "build-commands": [
        "cargo build --release --frozen --offline",
        "install -Dm0755 target/release/meowsystem-ascii-battery /app/bin/meowsystem-ascii-battery",
        "install -Dm0644 target/xdgen/io.github.meowsystem.AsciiBattery.desktop /app/share/applications/io.github.meowsystem.AsciiBattery.desktop",
        "install -Dm0644 target/xdgen/io.github.meowsystem.AsciiBattery.metainfo.xml /app/share/metainfo/io.github.meowsystem.AsciiBattery.metainfo.xml",
        "install -Dm0644 resources/io.github.meowsystem.AsciiBattery.svg /app/share/icons/hicolor/scalable/apps/io.github.meowsystem.AsciiBattery.svg"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/pewmoe/Cosmic-Desktop-ASCII-Battery-Applet",
          "branch": "update-v1.2.0",
          "commit": "9f2726bd1979b2a42c493a8ab98ca0926051eef5"
        },
        "cargo-sources.json"
      ]
    }
  ]
}