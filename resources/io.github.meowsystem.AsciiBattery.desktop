#!/usr/bin/env xdg-open
[Desktop Entry]
Name=Ascii Battery for the COSMIC™ desktop
Comment=Battery status, power profiles, and time remaining for COSMIC
Type=Application
Icon=io.github.meowsystem.AsciiBattery
Exec=meowsystem-ascii-battery
Terminal=false
StartupNotify=true
Categories=COSMIC
Keywords=COSMIC;Battery;Power;Laptop;
NoDisplay=true
X-CosmicApplet=true
X-CosmicHoverPopup=Auto
